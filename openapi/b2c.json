                  "$ref": "#/components/schemas/B2cAddressView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Making an address the default takes the default off the others.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/b2c/me/addresses/{id}": {
      "get": {
        "operationId": "CustomersB2cController_getAddress",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2cAddressView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "account"
        ]
      },
      "put": {
        "operationId": "CustomersB2cController_updateAddress",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/B2cAddressInputDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2cAddressView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "account"
        ]
      },
      "delete": {
        "operationId": "CustomersB2cController_deleteAddress",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Deleting the default makes the next address the default.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/b2c/me/sessions": {
      "get": {
        "operationId": "SessionsB2cController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceSessionView"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Devices the customer is logged in on, this one first.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/b2c/me/sessions/others": {
      "delete": {
        "operationId": "SessionsB2cController_revokeOthers",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Logs out every device except this one. Declared before `:id` so \"others\" isn't read as an id.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/b2c/me/sessions/{id}": {
      "delete": {
        "operationId": "SessionsB2cController_revoke",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Logs out one device.",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/b2c/auth/otp": {
      "post": {
        "operationId": "AuthB2cController_requestOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Sends a one-time code by SMS to this 10-digit mobile number.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/b2c/auth/otp/verify": {
      "post": {
        "operationId": "AuthB2cController_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpVerificationView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Checks the code. A new number also needs a name, which creates the account.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/b2c/auth/session": {
      "get": {
        "operationId": "AuthB2cController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2cSessionView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/b2c/auth/logout": {
      "post": {
        "operationId": "AuthB2cController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "SpareX B2C API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateB2cProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email"
          },
          "gstin": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "email",
          "gstin"
        ]
      },
      "B2cUserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mobile": {
            "type": "string",
            "description": "10-digit Indian mobile number without the country code."
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "gstin": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mobile",
          "email",
          "gstin",
          "createdAt"
        ]
      },
      "B2cAddressView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "example": "Home",
            "enum": [
              "Home",
              "Work",
              "Other"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "name",
          "mobile",
          "pin",
          "line1",
          "area",
          "city",
          "state",
          "isDefault"
        ]
      },
      "B2cAddressInputDto": {
        "type": "object",
        "properties": {
          "label": {
            "enum": [
              "Home",
              "Work",
              "Other"
            ],
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "mobile": {
            "type": "string"
          },
          "pin": {
            "type": "string",
            "pattern": "^[1-9]\\d{5}$"
          },
          "line1": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "area": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "name",
          "mobile",
          "pin",
          "line1",
          "area",
          "city",
          "state",
          "isDefault"
        ]
      },
      "DeviceSessionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "example": "computer",
            "enum": [
              "phone",
              "tablet",
              "computer"
            ]
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "Approximate, from the network. Empty until a location lookup is chosen (B-08)."
          },
          "signedInAt": {
            "type": "string"
          },
          "lastActiveAt": {
            "type": "string"
          },
          "isCurrent": {
            "type": "boolean",
            "description": "The device this request came from."
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "location",
          "signedInAt",
          "lastActiveAt",
          "isCurrent"
        ]
      },
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string"
          }
        },
        "required": [
          "mobile"
        ]
      },
      "OtpRequestView": {
        "type": "object",
        "properties": {
          "isNewUser": {
            "type": "boolean",
            "description": "No account yet for this number: the customer gives their name and an account is created."
          },
          "resendAfterSeconds": {
            "type": "number"
          }
        },
        "required": [
          "isNewUser",
          "resendAfterSeconds"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string"
          },
          "otp": {
            "type": "string",
            "pattern": "^\\d{4,10}$"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Required only for a new number, where it creates the account.",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "mobile",
          "otp",
          "name"
        ]
      },
      "OtpVerificationView": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/B2cUserView"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "B2cSessionView": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/B2cUserView"
          }
        },
        "required": [
          "user"
        ]
      }
    }
  }
}
