  "info": {
    "title": "SpareX Admin API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ActorRefView": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "admin",
            "enum": [
              "admin",
              "customer",
              "business",
              "garage",
              "system"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "name"
        ]
      },
      "AuditChangeView": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "before": {
            "type": "string",
            "nullable": true
          },
          "after": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "field",
          "before",
          "after"
        ]
      },
      "AuditEntryView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "actor": {
            "$ref": "#/components/schemas/ActorRefView"
          },
          "action": {
            "example": "update",
            "enum": [
              "delete",
              "create",
              "update",
              "status_change",
              "approve",
              "reject",
              "export",
              "import",
              "sign_in"
            ],
            "type": "string"
          },
          "entity": {
            "example": "product",
            "enum": [
              "customer",
              "business",
              "garage",
              "product",
              "price",
              "fitment",
              "stock",
              "order",
              "return",
              "payment",
              "credit",
              "credit_note",
              "quotation",
              "application",
              "booking",
              "vehicle",
              "master",
              "content",
              "coupon",
              "enquiry",
              "review",
              "admin_user",
              "settings",
              "report"
            ],
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "entityLabel": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditChangeView"
            }
          }
        },
        "required": [
          "id",
          "at",
          "actor",
          "action",
          "entity",
          "entityId",
          "entityLabel",
          "summary",
          "changes"
        ]
      },
      "AuditEntryPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryView"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "RecordExportDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "export"
            ]
          },
          "entity": {
            "type": "string",
            "enum": [
              "product",
              "price",
              "fitment",
              "stock",
              "order",
              "return",
              "payment",
              "credit",
              "credit_note",
              "quotation",
              "business",
              "application",
              "garage",
              "booking",
              "customer",
              "vehicle",
              "master",
              "content",
              "coupon",
              "enquiry",
              "review",
              "admin_user",
              "settings",
              "report"
            ]
          },
          "entityId": {
            "type": "string",
            "description": "Always empty for an export.",
            "enum": [
              ""
            ]
          },
          "entityLabel": {
            "type": "string",
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "changes": {
            "type": "array",
            "description": "Always empty for an export.",
            "items": {
              "type": "number",
              "enum": []
            }
          }
        },
        "required": [
          "action",
          "entity",
          "entityId",
          "entityLabel",
          "summary",
          "changes"
        ]
      },
      "AttachmentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Public files: a stable URL that may be stored and cached. Private files: a signed link that works for\nSIGNED_URL_TTL_SECONDS, so store the `id` and fetch a fresh link when showing it."
          },
          "visibility": {
            "example": "private",
            "enum": [
              "public",
              "private"
            ],
            "type": "string"
          },
          "mimeType": {
            "example": "image/jpeg",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "application/pdf"
            ],
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "visibility",
          "mimeType",
          "sizeBytes"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInResultView": {
        "type": "object",
        "properties": {
          "kind": {
            "example": "signed_in",
            "enum": [
              "signed_in",
              "two_step_required"
            ],
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "TwoStepChallengeView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "maskedPhone": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "demoCode": {
            "type": "string",
            "nullable": true,
            "description": "Only set locally (SMS_PROVIDER=console), where no SMS is sent."
          }
        },
        "required": [
          "id",
          "maskedPhone",
          "expiresAt",
          "demoCode"
        ]
      },
      "VerifyTwoStepDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "maxLength": 64
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{4,10}$"
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "AdminUserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "E.164, e.g. \"+919845012345\"."
          },
          "roleId": {
            "type": "string"
          },
          "status": {
            "example": "active",
            "enum": [
              "active",
              "inactive",
              "invited"
            ],
            "type": "string"
          },
          "twoStepEnabled": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "roleId",
          "status",
          "twoStepEnabled",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequestView": {
        "type": "object",
        "properties": {
          "demoToken": {
            "type": "string",
            "nullable": true,
            "description": "Only set locally (EMAIL_PROVIDER=console), where no email is sent."
          }
        },
        "required": [
          "demoToken"
        ]
      },
      "ConfirmPasswordResetDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "UpdateAdminProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "description": "Any common form; stored as E.164."
          }
        },
        "required": [
          "name",
          "phone"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "SetTwoStepDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ]
      }
    }
  }
}
