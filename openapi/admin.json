{
  "openapi": "3.0.0",
  "paths": {
    "/v1/admin/audit-log": {
      "get": {
        "operationId": "AuditAdminController_list",
        "parameters": [
          {
            "name": "entity",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "product",
                "price",
                "fitment",
                "stock",
                "order",
                "return",
                "payment",
                "credit",
                "credit_note",
                "quotation",
                "business",
                "application",
                "garage",
                "booking",
                "customer",
                "vehicle",
                "master",
                "content",
                "coupon",
                "enquiry",
                "review",
                "admin_user",
                "settings",
                "report"
              ]
            }
          },
          {
            "name": "action",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "create",
                "update",
                "delete",
                "status_change",
                "approve",
                "reject",
                "export",
                "import",
                "sign_in"
              ]
            }
          },
          {
            "name": "actor",
            "required": false,
            "in": "query",
            "description": "Actor id, e.g. the signed-in admin for \"My activity\".",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "record",
            "required": false,
            "in": "query",
            "description": "Record id, for a record's activity timeline.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": true,
            "in": "query",
            "schema": {
              "default": 20,
              "type": "number",
              "enum": [
                10,
                20,
                50,
                100
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Free-text search.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "`field.asc` or `field.desc`.",
            "schema": {
              "pattern": "^[A-Za-z0-9_]+\\.(asc|desc)$",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "First day included, `YYYY-MM-DD` in Asia/Kolkata.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Last day included, `YYYY-MM-DD` in Asia/Kolkata.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEntryPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The audit log, newest first by default. Filters: entity, action, actor, record.",
        "tags": [
          "audit-log"
        ]
      },
      "post": {
        "operationId": "AuditAdminController_recordExport",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordExportDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Records a CSV export made in the panel.",
        "tags": [
          "audit-log"
        ]
      }
    },
