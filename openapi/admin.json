              "type": "string"
            }
          },
          {
            "name": "record",
            "required": false,
            "in": "query",
            "description": "Record id, for a record's activity timeline.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": true,
            "in": "query",
            "schema": {
              "default": 20,
              "type": "number",
              "enum": [
                10,
                20,
                50,
                100
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Free-text search.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "`field.asc` or `field.desc`.",
            "schema": {
              "pattern": "^[A-Za-z0-9_]+\\.(asc|desc)$",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "First day included, `YYYY-MM-DD` in Asia/Kolkata.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Last day included, `YYYY-MM-DD` in Asia/Kolkata.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntryView"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Every matching entry (up to 10,000), for CSV export.",
        "tags": [
          "audit-log"
        ]
      }
    },
    "/v1/admin/uploads": {
      "post": {
        "operationId": "FilesAdminController_upload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private"
                    ],
                    "default": "private"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Uploads one image (JPEG, PNG, WebP) or PDF as multipart field `file`, with an optional `visibility`.",
        "tags": [
          "files"
        ]
      }
    },
    "/v1/admin/files/{id}": {
      "get": {
        "operationId": "FilesAdminController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The file with its link: stable for a public file, freshly signed for a private one.",
        "tags": [
          "files"
        ]
      }
    },
