# Copy to .env for local development. The app refuses to start when a value is missing or invalid
# (src/config/env.ts). Tests and `npm run dev:memory` replace MONGO_URI with an in-memory replica set.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Express "trust proxy": which proxies may set X-Forwarded-For. "false", "loopback", or a comma list of IPs/CIDRs.
TRUST_PROXY=loopback

# Your own database on the team's free Atlas M0 cluster. Keep "_dev" in the name: `npm run seed` refuses otherwise.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kannali_dev_<name>?retryWrites=true&w=majority
# On locally; off in staging and production, where `npm run db:indexes` applies them.
MONGO_AUTO_INDEX=true

# The API's own address, used in links to files kept on local disk.
PUBLIC_BASE_URL=http://localhost:4000
# Uploads go here unless S3 is configured below. Git-ignored.
LOCAL_UPLOADS_DIR=uploads
# Signs the short-lived links to private files on local disk. At least 32 characters.
FILE_URL_SECRET=local-only-file-url-secret-change-me-000000
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=300

# S3 (staging and production). Leave the bucket and keys empty to use local disk. All three together, or none.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Where files under public/ are read from (bucket website or CDN), e.g. https://cdn.kannaligarage.in
S3_PUBLIC_BASE_URL=

# "console" logs SMS codes and emails instead of sending them. Not allowed when NODE_ENV=production.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@kannaligarage.in
# Used to build the password reset link in the email.
ADMIN_APP_URL=http://localhost:3001

# Session lifetimes (B-01).
SESSION_TTL_ADMIN_SECONDS=43200
SESSION_TTL_B2C_SECONDS=2592000
SESSION_TTL_B2B_SECONDS=604800

# One-time codes (B-05). OTP_SECRET keys the code hashes; at least 32 characters.
OTP_SECRET=local-only-otp-secret-change-me-0000000000
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Password sign-in lockout (B-06) and reset links.
SIGN_IN_MAX_FAILURES=5
SIGN_IN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Rate limits (in memory, one server instance): every route per IP; sign-in, OTP and password reset per IP and
# per email or phone number.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_IDENTITY_PER_HOUR=20
